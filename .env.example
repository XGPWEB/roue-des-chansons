# Copier en .env.local et remplir. En production : Vercel → Settings → Environment Variables.
# Format : { "<slug de la roue>": ["Artiste - Titre", ...] } — accents, majuscules et ponctuation ignorés.
VRAIES_CHANSONS=`{"chansons":["Artiste - Titre","Autre artiste - Autre titre"]}`

# Clé API YouTube Data v3 (recherche des vidéos karaoké). Sans clé : seuls les liens collés dans l'éditeur sont lus.
YOUTUBE_API_KEY=
